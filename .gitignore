# ============================================
#  .gitignore —— 告诉 Git "这些文件不要管"
# ============================================

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
# 但 Maven Wrapper 的 jar 要保留，它保证别人 clone 后不用装 Maven 也能构建
!.mvn/wrapper/maven-wrapper.jar

# ---------- IntelliJ IDEA ----------
# IDE 的个人配置不应该共享，每个人用自己喜欢的编辑器就好
.idea/
*.iml
*.iws
*.ipr
out/

# ---------- 前端 Node ----------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 运行日志与临时文件 ----------
logs/
*.log
*.tmp

# ---------- 操作系统生成的文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地私有配置（绝不提交） ----------
application-local.yml
application-local.properties
.env
.env.local
